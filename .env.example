# ==============================================================================
# Connect Social Media — Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
# For Render deployment, add these variables in your Render Dashboard Environment tab.
# ==============================================================================

# Server Configuration
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Session & Authentication Secrets
# Generate a strong 32+ character random string (e.g. using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_super_secret_session_key_here_change_in_production
JWT_SECRET=your_jwt_secret_key_if_needed

# Database Configuration
# Path to SQLite database file. On Render with Persistent Disk, point to mounted path (e.g. /var/data/connect.db)
DATABASE_PATH=./database/connect.db

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. https://your-frontend.onrender.com,http://localhost:3000)
CLIENT_URL=http://localhost:3000

# Cloudinary Storage (Required for Render ephemeral disk — stores uploaded post images, videos, avatars, covers)
# Get these free credentials from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional single connection URI alternative:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Frontend API Base URL (if frontend is hosted on separate domain or needs explicit base URL)
API_BASE_URL=
