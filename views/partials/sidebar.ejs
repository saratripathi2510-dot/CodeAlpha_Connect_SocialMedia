<%
// Helper: get first letter of name for avatar placeholder
function initials(user) {
  if (!user) return 'U';
  const name = user.display_name || user.username || 'U';
  return name.charAt(0).toUpperCase();
}
const navUser = currentUser;
%>
<aside class="sidebar" role="navigation" aria-label="Main navigation">

  <!-- Brand -->
  <a href="/" class="sidebar-brand" aria-label="Connect home">
    <div class="sidebar-brand-logo">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    </div>
    <div>
      <div class="sidebar-brand-name">Connect</div>
      <div class="sidebar-brand-tagline">Good People. Better Conversations.</div>
    </div>
  </a>

  <!-- Main Nav -->
  <nav>
    <a href="/" class="nav-item <%= locals.path === '/' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span class="nav-label">Home</span>
    </a>

    <a href="/explore" class="nav-item <%= locals.path && locals.path.startsWith('/explore') ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <span class="nav-label">Explore</span>
    </a>

    <a href="/notifications" class="nav-item <%= locals.path && locals.path.startsWith('/notifications') ? 'active' : '' %>" style="position:relative">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <span class="nav-label">Notifications</span>
      <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
        <span class="nav-badge" id="notif-badge"><%= unreadNotifications %></span>
      <% } else { %>
        <span class="nav-badge" id="notif-badge" style="display:none">0</span>
      <% } %>
    </a>

    <a href="/messages" class="nav-item <%= locals.path && locals.path.startsWith('/messages') ? 'active' : '' %>" style="position:relative">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="nav-label">Messages</span>
      <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
        <span class="nav-badge" id="msg-badge"><%= unreadMessages %></span>
      <% } else { %>
        <span class="nav-badge" id="msg-badge" style="display:none">0</span>
      <% } %>
    </a>

    <a href="/bookmarks" class="nav-item <%= locals.path && locals.path.startsWith('/bookmarks') ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>
      </svg>
      <span class="nav-label">Saved</span>
    </a>

    <% if (navUser) { %>
    <a href="/u/<%= navUser.username %>" class="nav-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4"/>
        <path d="M20 21a8 8 0 1 0-16 0"/>
      </svg>
      <span class="nav-label">Profile</span>
    </a>
    <% } %>

    <a href="/settings" class="nav-item <%= locals.path && locals.path.startsWith('/settings') ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      <span class="nav-label">Settings</span>
    </a>
  </nav>

  <!-- Footer: User + Theme toggle -->
  <div class="sidebar-footer">
    <!-- Theme cycle button -->
    <button id="theme-cycle" class="theme-toggle" style="width:100%;margin-bottom:var(--space-3);" aria-label="Toggle theme">
      <span id="theme-icon">☀️</span>
      <span id="theme-label">Light</span>
    </button>

    <% if (navUser) { %>
    <div class="dropdown">
      <div class="sidebar-user" data-dropdown-trigger tabindex="0" role="button" aria-haspopup="true">
        <% if (navUser.avatar_url) { %>
          <img src="<%= navUser.avatar_url %>" alt="<%= navUser.display_name %>" class="avatar avatar-md">
        <% } else { %>
          <div class="avatar avatar-md avatar-placeholder"><%= initials(navUser) %></div>
        <% } %>
        <div class="sidebar-user-info">
          <div class="sidebar-user-name"><%= navUser.display_name %></div>
          <div class="sidebar-user-handle">@<%= navUser.username %></div>
        </div>
        <button class="sidebar-more-btn" aria-label="More options">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
          </svg>
        </button>
      </div>
      <div class="dropdown-menu">
        <a href="/u/<%= navUser.username %>" class="dropdown-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
          View Profile
        </a>
        <a href="/settings" class="dropdown-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/></svg>
          Settings
        </a>
        <hr style="margin:4px 0;border-color:var(--border)">
        <form action="/logout" method="POST" style="margin:0">
          <button type="submit" class="dropdown-item danger">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign Out
          </button>
        </form>
      </div>
    </div>
    <% } %>
  </div>
</aside>
