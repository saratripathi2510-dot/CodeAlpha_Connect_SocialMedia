<%
function initials(user) {
  if (!user) return 'U';
  const name = user.display_name || user.username || 'U';
  return name.charAt(0).toUpperCase();
}
%>
<aside class="right-sidebar" aria-label="Trending and suggestions">

  <!-- Search -->
  <div class="search-bar" role="search">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      type="text"
      placeholder="Search Connect..."
      id="global-search"
      autocomplete="off"
      aria-label="Search"
      onkeydown="if(event.key==='Enter'){window.location='/explore?q='+encodeURIComponent(this.value)}"
    >
  </div>

  <!-- Trending Topics -->
  <% if (typeof trending !== 'undefined' && trending && trending.length > 0) { %>
  <div class="sidebar-widget">
    <div class="sidebar-widget-title">Trending</div>
    <div class="card card-flat" style="padding:var(--space-3) 0">
      <% trending.forEach((t, i) => { %>
        <% const tag = t.tag ? t.tag.split(' ')[0] : null; %>
        <% if (tag) { %>
        <a href="/explore?q=<%= encodeURIComponent(tag) %>" style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-2) var(--space-4);text-decoration:none;transition:var(--transition-fast)" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background=''">
          <div>
            <div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:2px">Trending</div>
            <div style="font-size:0.9375rem;font-weight:600;color:var(--text-primary)"><%= tag %></div>
            <div style="font-size:0.75rem;color:var(--text-muted)"><%= t.count %> posts</div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <% } %>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- Suggested Users -->
  <% if (typeof suggested !== 'undefined' && suggested && suggested.length > 0) { %>
  <div class="sidebar-widget">
    <div class="sidebar-widget-title">Who to Follow</div>
    <div class="card card-padded card-flat" style="padding:var(--space-3) var(--space-4)">
      <% suggested.forEach(user => { %>
      <div class="user-chip" style="margin-bottom:var(--space-3)">
        <a href="/u/<%= user.username %>" style="display:flex;align-items:center;gap:var(--space-2);text-decoration:none">
          <% if (user.avatar_url) { %>
            <img src="<%= user.avatar_url %>" alt="<%= user.display_name %>" class="avatar avatar-sm">
          <% } else { %>
            <div class="avatar avatar-sm avatar-placeholder"><%= initials(user) %></div>
          <% } %>
        </a>
        <div class="user-chip-info">
          <a href="/u/<%= user.username %>" class="user-chip-name" style="text-decoration:none;color:var(--text-primary);font-size:0.875rem;font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= user.display_name %></a>
          <div class="user-chip-handle">@<%= user.username %></div>
        </div>
        <form action="/u/<%= user.username %>/follow" method="POST" style="margin:0">
          <button type="submit" class="btn btn-outline btn-sm">Follow</button>
        </form>
      </div>
      <% }); %>

      <a href="/explore" class="btn btn-ghost btn-sm" style="width:100%;justify-content:center;margin-top:var(--space-2)">Show more</a>
    </div>
  </div>
  <% } %>

  <!-- Footer links -->
  <div style="font-size:0.75rem;color:var(--text-muted);padding:0 var(--space-1);line-height:1.8">
    <a href="/settings" style="color:var(--text-muted);text-decoration:none">Settings</a> ·
    <a href="/explore" style="color:var(--text-muted);text-decoration:none">Explore</a>
    <br>
    <span>© 2024 Connect</span>
  </div>
</aside>
