<%- include('partials/head') %>
<div class="app-shell">
  <%- include('partials/sidebar') %>

  <main class="main-content" style="max-width:760px;margin:0 auto;padding-left:var(--space-5);padding-right:var(--space-5)">

    <!-- Cover Image -->
    <div class="profile-cover" style="<%= profile.cover_url ? 'background-image:url(' + profile.cover_url + ')' : '' %>">
      <% if (isOwnProfile) { %>
      <form action="/settings/cover" method="POST" enctype="multipart/form-data" style="position:absolute;bottom:var(--space-3);right:var(--space-3)">
        <label class="btn btn-sm" style="background:rgba(0,0,0,0.5);color:white;border-color:rgba(255,255,255,0.3);cursor:pointer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          Change cover
          <input type="file" name="cover" accept="image/*" style="display:none" onchange="this.form.submit()">
        </label>
      </form>
      <% } %>
    </div>

    <!-- Profile Header -->
    <div class="profile-header-card">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:var(--space-3)">
        <!-- Avatar -->
        <div style="position:relative;margin-top:-52px">
          <% if (profile.avatar_url) { %>
            <img src="<%= profile.avatar_url %>" alt="<%= profile.display_name %>" class="avatar avatar-2xl" style="border:4px solid var(--bg-card);box-shadow:var(--shadow-sm)">
          <% } else { %>
            <div class="avatar avatar-2xl avatar-placeholder" style="border:4px solid var(--bg-card);box-shadow:var(--shadow-sm);font-size:2.5rem"><%= profile.display_name.charAt(0).toUpperCase() %></div>
          <% } %>
          <% if (isOwnProfile) { %>
          <form action="/settings/avatar" method="POST" enctype="multipart/form-data" style="position:absolute;bottom:4px;right:4px">
            <label style="width:28px;height:28px;border-radius:50%;background:var(--sage);color:white;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--shadow-sm)" aria-label="Change avatar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
              <input type="file" name="avatar" accept="image/*" style="display:none" onchange="this.form.submit()">
            </label>
          </form>
          <% } %>
        </div>

        <!-- Actions -->
        <div style="display:flex;gap:var(--space-2);flex-wrap:wrap">
          <% if (isOwnProfile) { %>
            <a href="/settings" class="btn btn-outline btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Edit Profile
            </a>
          <% } else { %>
            <form action="/u/<%= profile.username %>/follow" method="POST">
              <button type="submit" class="btn <%= isFollowing ? 'btn-outline' : 'btn-primary' %> btn-sm">
                <%= isFollowing ? 'Following' : 'Follow' %>
              </button>
            </form>
            <a href="/messages/<%= profile.username %>" class="btn btn-ghost btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Message
            </a>
          <% } %>
        </div>
      </div>

      <!-- Profile Info -->
      <div style="margin-top:var(--space-3)">
        <h1 class="profile-name"><%= profile.display_name %></h1>
        <div class="profile-username">@<%= profile.username %></div>
        <% if (profile.bio) { %>
          <p class="profile-bio"><%= profile.bio %></p>
        <% } %>
        <div class="profile-meta">
          <% if (profile.location) { %>
          <span class="profile-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= profile.location %>
          </span>
          <% } %>
          <% if (profile.website) { %>
          <span class="profile-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <a href="<%= profile.website %>" target="_blank" rel="noopener" style="color:var(--sage)"><%= profile.website.replace(/^https?:\/\//, '') %></a>
          </span>
          <% } %>
          <span class="profile-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Joined <%= formatDateFull(profile.created_at) %>
          </span>
        </div>
      </div>

      <!-- Stats -->
      <div class="profile-stats">
        <div class="profile-stat">
          <span class="profile-stat-value"><%= posts.length %></span>
          <span class="profile-stat-label">Posts</span>
        </div>
        <a href="/u/<%= profile.username %>?tab=followers" class="profile-stat" style="text-decoration:none">
          <span class="profile-stat-value"><%= followerCount %></span>
          <span class="profile-stat-label">Followers</span>
        </a>
        <a href="/u/<%= profile.username %>?tab=following" class="profile-stat" style="text-decoration:none">
          <span class="profile-stat-value"><%= followingCount %></span>
          <span class="profile-stat-label">Following</span>
        </a>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs" style="margin-bottom:var(--space-4)">
      <a href="/u/<%= profile.username %>?tab=posts" class="tab-btn <%= activeTab === 'posts' ? 'active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 9h6M9 12h6M9 15h3"/></svg>
        Posts
      </a>
      <% if (isOwnProfile) { %>
      <a href="/u/<%= profile.username %>?tab=saved" class="tab-btn <%= activeTab === 'saved' ? 'active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
        Saved
      </a>
      <% } %>
    </div>

    <!-- Tab Content -->
    <% if (activeTab === 'posts') { %>
      <% if (posts && posts.length > 0) { %>
        <div style="display:flex;flex-direction:column;gap:var(--space-4)">
          <% posts.forEach(post => { %>
            <%- include('partials/post-card', { post }) %>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon">🌱</div>
          <h3><%= isOwnProfile ? 'Share your first post' : 'No posts yet' %></h3>
          <p><%= isOwnProfile ? 'Your posts will appear here.' : profile.display_name + ' hasn\'t posted yet.' %></p>
          <% if (isOwnProfile) { %>
            <a href="/" class="btn btn-primary" style="margin-top:var(--space-4)">Create Post</a>
          <% } %>
        </div>
      <% } %>

    <% } else if (activeTab === 'saved' && isOwnProfile) { %>
      <% if (savedPosts && savedPosts.length > 0) { %>
        <div style="display:flex;flex-direction:column;gap:var(--space-4)">
          <% savedPosts.forEach(post => { %>
            <%- include('partials/post-card', { post }) %>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon">🔖</div>
          <h3>No saved posts</h3>
          <p>Bookmark posts to find them here later.</p>
        </div>
      <% } %>
    <% } %>

  </main>

  <%- include('partials/right-sidebar') %>
</div>

<script src="/js/theme.js"></script>
<script src="/js/feed.js"></script>
</body>
</html>
