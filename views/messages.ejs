<%- include('partials/head') %>
<div class="app-shell">
  <%- include('partials/sidebar') %>

  <main class="main-content">
    <div class="messages-layout" id="messages-layout">

      <!-- Conversation List -->
      <div class="messages-list-panel">
        <div class="messages-list-header">
          <h1 style="font-family:var(--font-serif);font-size:1.25rem;font-weight:700;color:var(--text-primary);margin-bottom:var(--space-3)">Messages</h1>
          <!-- Search conversation -->
          <div class="search-bar" style="padding:var(--space-2) var(--space-3)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="text" placeholder="Search messages..." id="conv-search" style="font-size:0.875rem" aria-label="Search conversations">
          </div>
        </div>
        <div class="messages-list-body" id="conversation-list">
          <% if (conversations && conversations.length > 0) { %>
            <% conversations.forEach(conv => { %>
            <a
              href="/messages/<%= conv.username %>"
              class="conversation-item <%= activeConversation && activeConversation.username === conv.username ? 'active' : '' %>"
            >
              <% if (conv.avatar_url) { %>
                <img src="<%= conv.avatar_url %>" alt="<%= conv.display_name %>" class="avatar avatar-md">
              <% } else { %>
                <div class="avatar avatar-md avatar-placeholder"><%= conv.display_name.charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="conversation-preview">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-2)">
                  <span class="conversation-name"><%= conv.display_name %></span>
                  <% if (conv.last_message_at) { %>
                    <span style="font-size:0.6875rem;color:var(--text-muted);white-space:nowrap"><%= formatDate(conv.last_message_at) %></span>
                  <% } %>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between">
                  <span class="conversation-last"><%= conv.last_message || 'No messages yet' %></span>
                  <% if (conv.unread_count > 0) { %>
                    <span class="badge-count"><%= conv.unread_count %></span>
                  <% } %>
                </div>
              </div>
            </a>
            <% }); %>
          <% } else { %>
            <div class="empty-state" style="padding:var(--space-8) var(--space-4)">
              <div class="empty-icon" style="font-size:2rem">💬</div>
              <h3 style="font-size:1rem">No conversations</h3>
              <p style="font-size:0.875rem">Start a conversation by visiting someone's profile.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Chat Panel -->
      <div class="messages-chat-panel">
        <% if (activeConversation) { %>

          <!-- Chat Header -->
          <div class="messages-chat-header">
            <a href="/messages" class="btn btn-icon btn-ghost" style="display:none" id="back-to-list" aria-label="Back to conversations">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            </a>
            <% if (activeConversation.avatar_url) { %>
              <img src="<%= activeConversation.avatar_url %>" alt="<%= activeConversation.display_name %>" class="avatar avatar-md">
            <% } else { %>
              <div class="avatar avatar-md avatar-placeholder"><%= activeConversation.display_name.charAt(0).toUpperCase() %></div>
            <% } %>
            <div style="flex:1">
              <a href="/u/<%= activeConversation.username %>" style="font-size:1rem;font-weight:700;color:var(--text-primary);text-decoration:none;display:block"><%= activeConversation.display_name %></a>
              <span style="font-size:0.8125rem;color:var(--text-muted)">@<%= activeConversation.username %></span>
            </div>
            <a href="/u/<%= activeConversation.username %>" class="btn btn-ghost btn-sm">View profile</a>
          </div>

          <!-- Messages -->
          <div class="messages-chat-body" id="chat-body">
            <div id="conversation-username" data-username="<%= activeConversation.username %>" style="display:none"></div>
            <% if (messages && messages.length > 0) { %>
              <% messages.forEach((msg, idx) => { %>
                <%
                  const isOwn = msg.sender_id === currentUser.id;
                  const showDate = idx === 0 || formatDate(messages[idx-1].created_at) !== formatDate(msg.created_at);
                %>

                <% if (showDate) { %>
                <div style="text-align:center;margin:var(--space-3) 0">
                  <span style="font-size:0.75rem;color:var(--text-muted);background:var(--bg-main);padding:var(--space-1) var(--space-3);border-radius:var(--radius-full)"><%= formatDateFull(msg.created_at) %></span>
                </div>
                <% } %>

                <div style="display:flex;flex-direction:column;align-items:<%= isOwn ? 'flex-end' : 'flex-start' %>;gap:2px"
                     data-last-msg-id="<%= msg.id %>">
                  <div class="message-bubble <%= isOwn ? 'outgoing' : 'incoming' %>"><%= msg.content %></div>
                  <time class="message-time <%= isOwn ? 'outgoing-time' : '' %>"><%= formatDate(msg.created_at) %></time>
                </div>
              <% }); %>
            <% } else { %>
              <div class="empty-state" style="flex:1;justify-content:center">
                <div class="empty-icon" style="font-size:2.5rem">👋</div>
                <h3>Say hello!</h3>
                <p>Send your first message to <%= activeConversation.display_name %>.</p>
              </div>
            <% } %>
          </div>

          <!-- Message Composer -->
          <div class="messages-chat-footer">
            <form action="/messages/<%= activeConversation.username %>" method="POST" class="message-composer">
              <textarea
                id="message-input"
                name="content"
                class="message-composer-input"
                placeholder="Write a message..."
                rows="1"
                maxlength="2000"
                required
                aria-label="Message input"
              ></textarea>
              <button type="submit" class="btn btn-primary" aria-label="Send message" style="height:44px;padding:0 var(--space-4)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </form>
          </div>

        <% } else { %>
          <!-- No conversation selected -->
          <div class="empty-state" style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center">
            <div class="empty-icon" style="font-size:3.5rem">💌</div>
            <h3>Your messages</h3>
            <p>Select a conversation to start chatting, or visit someone's profile to send them a message.</p>
            <a href="/explore" class="btn btn-primary" style="margin-top:var(--space-4)">Find people</a>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script src="/js/theme.js"></script>
<script src="/js/feed.js"></script>
<script src="/js/messages.js"></script>
<script>
  // Conversation search filter
  const convSearch = document.getElementById('conv-search');
  if (convSearch) {
    convSearch.addEventListener('input', () => {
      const q = convSearch.value.toLowerCase();
      document.querySelectorAll('#conversation-list .conversation-item').forEach(item => {
        const name = item.querySelector('.conversation-name')?.textContent.toLowerCase() || '';
        item.style.display = name.includes(q) ? '' : 'none';
      });
    });
  }

  // Mobile: show back button
  if (window.innerWidth <= 768) {
    const backBtn = document.getElementById('back-to-list');
    if (backBtn) backBtn.style.display = 'flex';
  }
</script>
</body>
</html>
