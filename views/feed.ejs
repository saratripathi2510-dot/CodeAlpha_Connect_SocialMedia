<%- include('partials/head') %>
<div class="app-shell">
  <%- include('partials/sidebar') %>

  <main class="main-content" id="main-content">
    <!-- Flash Messages -->
    <% if (typeof flash_success !== 'undefined' && flash_success) { %>
      <div class="flash flash-success" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <%= flash_success %>
      </div>
    <% } %>

    <div class="feed-wrapper">

      <!-- Stories Bar -->
      <% if (stories && stories.length > 0) { %>
      <div class="stories-bar" role="region" aria-label="Stories">
        <% stories.forEach(user => { %>
        <a href="/u/<%= user.username %>" class="story-item">
          <div class="story-ring">
            <% if (user.avatar_url) { %>
              <img src="<%= user.avatar_url %>" alt="<%= user.display_name %>" class="avatar avatar-sm" style="border:2.5px solid var(--bg-card)">
            <% } else { %>
              <div class="avatar avatar-sm avatar-placeholder" style="border:2.5px solid var(--bg-card)"><%= user.display_name.charAt(0).toUpperCase() %></div>
            <% } %>
          </div>
          <span class="story-label"><%= user.username %></span>
        </a>
        <% }); %>
      </div>
      <% } %>

      <!-- Post Composer -->
      <div class="composer-card" role="region" aria-label="Create post">
        <form action="/posts" method="POST" enctype="multipart/form-data">
          <div class="composer-row">
            <% if (currentUser && currentUser.avatar_url) { %>
              <img src="<%= currentUser.avatar_url %>" alt="<%= currentUser.display_name %>" class="avatar avatar-md" style="margin-top:2px">
            <% } else { %>
              <div class="avatar avatar-md avatar-placeholder" style="margin-top:2px"><%= currentUser ? currentUser.display_name.charAt(0).toUpperCase() : 'U' %></div>
            <% } %>
            <div class="composer-input">
              <textarea
                id="post-content"
                name="content"
                class="composer-textarea"
                placeholder="What's on your mind?"
                maxlength="500"
                data-autoresize
                aria-label="Post content"
                required
              ></textarea>
              <div id="media-preview-wrap" class="media-preview-wrap">
                <img id="media-preview-img" src="" alt="Media preview" class="media-preview-img">
                <button type="button" id="media-preview-remove" class="media-preview-remove" aria-label="Remove media">✕</button>
              </div>
            </div>
          </div>
          <div class="composer-footer">
            <div class="composer-actions">
              <label class="composer-action-btn" style="cursor:pointer" aria-label="Add photo or video">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                Photo
                <input type="file" id="post-media" name="media" accept="image/*,video/*" style="display:none">
              </label>
            </div>
            <div style="display:flex;align-items:center;gap:var(--space-3)">
              <span id="char-count" class="char-count">500</span>
              <button type="submit" class="btn btn-primary btn-sm">Post</button>
            </div>
          </div>
        </form>
      </div>

      <!-- Feed Posts -->
      <% if (posts && posts.length > 0) { %>
        <% posts.forEach(post => { %>
          <%- include('partials/post-card', { post }) %>
        <% }); %>

        <% if (posts.length === 20) { %>
        <div style="text-align:center;padding:var(--space-4)">
          <a href="/?page=<%= page + 1 %>" class="btn btn-outline">Load more</a>
        </div>
        <% } %>

      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon">🌿</div>
          <h3>Your feed is quiet</h3>
          <p>Follow people to see their posts here, or explore what's happening.</p>
          <a href="/explore" class="btn btn-primary" style="margin-top:var(--space-4)">Explore Connect</a>
        </div>
      <% } %>

    </div><!-- /.feed-wrapper -->
  </main>

  <%- include('partials/right-sidebar') %>
</div>

<!-- Scripts -->
<script src="/js/theme.js"></script>
<script src="/js/feed.js"></script>
</body>
</html>
